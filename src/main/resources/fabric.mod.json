{
  "schemaVersion": 1,
  "id": "bluemap_minimap",
  "version": "${version}",
  "name": "BlueMap Minimap",
  "description": "A client-side minimap using your server's public BlueMap, with automatic discovery and in-game setup.",
  "authors": ["BlueMap Minimap contributors"],
  "license": "MIT",
  "icon": "assets/bluemap_minimap/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.bluemapminimap.client.BlueMapMinimapClient"
    ],
    "modmenu": [
      "dev.bluemapminimap.client.integration.BlueMapMinimapModMenu"
    ]
  },
  "mixins": [
    {
      "config": "bluemap-minimap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
