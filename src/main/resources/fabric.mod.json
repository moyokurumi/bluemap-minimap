{
  "schemaVersion": 1,
  "id": "bluemap_minimap",
  "version": "${version}",
  "name": "BlueMap Minimap for Moyo",
  "description": "A client-side BlueMap minimap with built-in settings for the Moyo server.",
  "authors": ["BlueMap Minimap contributors"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.bluemapminimap.client.BlueMapMinimapClient"
    ]
  },
  "mixins": [
    {
      "config": "bluemap-minimap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
